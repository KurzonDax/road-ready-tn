# Settings for this Instance. Copy this file to .env and fill it in.
# .env is ignored by git. See "Settings" in docs/self-hosting.md.

# Required: the public address people open, scheme and host only.
RRTN_ORIGIN=https://permit.example.org

# Required: the reverse proxy's IP, as the container sees it. Use * only when
# nothing but the proxy can reach the port.
RRTN_TRUSTED_PROXY=

# The port the server listens on, and that compose.yaml publishes on 127.0.0.1.
RRTN_PORT=8080

# The user and group the container runs as. The Instance folder must belong to them.
RRTN_UID=1000
RRTN_GID=1000

# The Instance folder on the host (default ./instance in the repo).
# RRTN_HOST_DIR=./instance
