{
  "section": 6,
  "title": "Turning and signaling",
  "steps": [
    {
      "id": "s6-01",
      "fact": "a-004",
      "kind": "choose",
      "prompt": "About how far back from the steering wheel do you sit?",
      "options": [
        "You sit about 3 to 5 inches back.",
        "You sit about 10 to 12 inches back.",
        "You sit about 18 to 24 inches back."
      ],
      "answer": "You sit about 10 to 12 inches back.",
      "then": {
        "say": "You sit about 10 to 12 inches back. Closer, an opening air bag hits your chin or face instead of your chest, and farther back you cannot reach the pedals and the wheel easily."
      },
      "rule": "You sit with your body about 10 to 12 inches back from the steering wheel, so an air bag that opens hits your chest, not your chin or face."
    },
    {
      "id": "s6-02",
      "fact": "a-003",
      "kind": "choose",
      "prompt": "Where do you put your hands on the steering wheel?",
      "options": [
        "Your left hand goes at 9 o'clock and your right hand at 3 o'clock.",
        "Your left hand goes at 10 o'clock and your right hand at 2 o'clock.",
        "Both hands go together at 12 o'clock."
      ],
      "answer": "Your left hand goes at 9 o'clock and your right hand at 3 o'clock.",
      "then": {
        "say": "Your left hand goes at 9 o'clock and your right hand at 3 o'clock. Higher on the wheel, at 10 and 2 o'clock or at 12 o'clock, your hands and arms are in the air bag's way if it opens."
      },
      "rule": "You hold the steering wheel with your left hand at 9 o'clock and your right hand at 3 o'clock, which helps you avoid injury if the air bag opens."
    },
    {
      "id": "s6-03",
      "fact": "b-147",
      "kind": "choose",
      "prompt": "How far before a turn does Tennessee law say your turn signal must be on?",
      "options": [
        "The law says at least 10 feet before the turn.",
        "The law says at least 50 feet before the turn.",
        "The law says at least 500 feet before the turn."
      ],
      "answer": "The law says at least 50 feet before the turn.",
      "then": {
        "say": "The law says your turn signal must be on at least 50 feet before the turn. Ten feet gives the drivers around you too little time to see what you plan to do, and 500 feet is ten times what the law asks."
      },
      "rule": "You turn on your turn signal at least 50 feet before a turn or a lane change."
    },
