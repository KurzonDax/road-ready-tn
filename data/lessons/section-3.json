    {
      "id": "s3-03",
      "kind": "principle",
      "prompt": "In both cases, who waited?",
      "options": [
        "You did, because you were entering a road that other cars were already on.",
        "The cars on the main road did, because they slowed down to let you in.",
        "No one did, because the car that was going faster went first."
      ],
      "answer": "You did, because you were entering a road that other cars were already on.",
      "then": {
        "say": "When you enter a road, you wait and let the traffic already on it go first. The law never gives anyone the right-of-way to take. It only says who must wait."
      }
    },
